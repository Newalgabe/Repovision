# GitHub personal access token — get one at https://github.com/settings/tokens
# No special scopes needed for public repos. Without this you get 60 req/hr.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# GitHub OAuth app — create one at https://github.com/settings/developers
# Set callback URL to http://localhost:3000/api/auth/github/callback (dev)
# or https://repovision-alpha.vercel.app/api/auth/github/callback (prod)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Session secret for storing OAuth tokens
SESSION_SECRET=change-this-to-a-random-string
